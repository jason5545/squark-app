+
+/* SQUARK_FAKEPAD=<path>: a virtual SDL gamepad (045e:02fd, like a Bluetooth Xbox
+ * Wireless Controller) driven by text lines written to the FIFO at <path>. It goes
+ * through SDL's game controller API and the rest of winebus like a real pad. */
+static SDL_Joystick *fakepad;
+static int fakepad_fd = -1;
+static char fakepad_line[256];
+static size_t fakepad_len;
 
+static const char *const fakepad_axes[] = {"lx", "ly", "rx", "ry", "lt", "rt"};
+static const char *const fakepad_buttons[] =
+{
+    "a", "b", "x", "y", "back", "guide", "start", "ls", "rs", "lb", "rb", "up", "down", "left", "right",
+};
+
+static void fakepad_reset(void)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(fakepad_axes); i++)
+        pSDL_JoystickSetVirtualAxis(fakepad, i, i >= 4 ? -32768 : 0);
+    for (i = 0; i < ARRAY_SIZE(fakepad_buttons); i++)
+        pSDL_JoystickSetVirtualButton(fakepad, i, 0);
+}
+
+/* "<axis> <value>" in raw SDL values, -32768 to 32767: sticks negative up and left,
+ * as SDL gives them, triggers -32768 released and 32767 fully pressed.
+ * "<button> <0|1>", or "reset". Lines end in a newline or ';'. */
+static void fakepad_command(const char *line)
+{
+    char name[16];
+    int value, i, fields;
+
+    fields = sscanf(line, "%15s %d", name, &value);
+    if (fields == 1 && !strcmp(name, "reset"))
+    {
+        fakepad_reset();
+        return;
+    }
+    if (fields != 2)
+    {
+        if (fields > 0) WARN("SQUARK_FAKEPAD: cannot read %s\n", debugstr_a(line));
+        return;
+    }
+    if (value < -32768) value = -32768;
+    if (value > 32767) value = 32767;
+    for (i = 0; i < ARRAY_SIZE(fakepad_axes); i++)
+        if (!strcmp(name, fakepad_axes[i]))
+        {
+            pSDL_JoystickSetVirtualAxis(fakepad, i, value);
+            return;
+        }
+    for (i = 0; i < ARRAY_SIZE(fakepad_buttons); i++)
+        if (!strcmp(name, fakepad_buttons[i]))
+        {
+            pSDL_JoystickSetVirtualButton(fakepad, i, value != 0);
+            return;
+        }
+    WARN("SQUARK_FAKEPAD: unknown control %s\n", debugstr_a(name));
+}
+
+static void fakepad_poll(void)
+{
+    char buf[256];
+    ssize_t count, i;
+
+    if (fakepad_fd < 0) return;
+    while ((count = read(fakepad_fd, buf, sizeof(buf))) > 0)
+    {
+        for (i = 0; i < count; i++)
+        {
+            if (buf[i] == '\n' || buf[i] == ';')
+            {
+                fakepad_line[fakepad_len] = 0;
+                fakepad_command(fakepad_line);
+                fakepad_len = 0;
+            }
+            else if (fakepad_len < sizeof(fakepad_line) - 1) fakepad_line[fakepad_len++] = buf[i];
+        }
+    }
+}
+
+static void fakepad_init(void)
+{
+    const char *path = getenv("SQUARK_FAKEPAD");
+    SDL_VirtualJoystickDesc desc;
+    int index;
+
+    if (!path || !*path) return;
+    if (!pSDL_JoystickAttachVirtualEx || !pSDL_JoystickSetVirtualAxis || !pSDL_JoystickSetVirtualButton)
+    {
+        ERR("SQUARK_FAKEPAD: this SDL has no virtual joysticks\n");
+        return;
+    }
+    if (mkfifo(path, 0600) && errno != EEXIST)
+    {
+        ERR("SQUARK_FAKEPAD: cannot make the FIFO %s: %s\n", debugstr_a(path), strerror(errno));
+        return;
+    }
+    /* Open it for reading and writing, so it never reads as closed between writers. */
+    if ((fakepad_fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC)) < 0)
+    {
+        ERR("SQUARK_FAKEPAD: cannot open %s: %s\n", debugstr_a(path), strerror(errno));
+        return;
+    }
+
+    memset(&desc, 0, sizeof(desc));
+    desc.version = SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+    desc.type = SDL_JOYSTICK_TYPE_GAMECONTROLLER;
+    desc.naxes = ARRAY_SIZE(fakepad_axes);
+    desc.nbuttons = ARRAY_SIZE(fakepad_buttons);
+    desc.vendor_id = 0x045e;
+    desc.product_id = 0x02fd;
+    desc.axis_mask = (1u << ARRAY_SIZE(fakepad_axes)) - 1;
+    desc.button_mask = (1u << ARRAY_SIZE(fakepad_buttons)) - 1;
+    desc.name = "squark fakepad";
+    if ((index = pSDL_JoystickAttachVirtualEx(&desc)) < 0 || !(fakepad = pSDL_JoystickOpen(index)))
+    {
+        ERR("SQUARK_FAKEPAD: cannot attach the virtual gamepad: %s\n", pSDL_GetError());
+        close(fakepad_fd);
+        fakepad_fd = -1;
+        return;
+    }
+    fakepad_reset();
+    MESSAGE("winebus: SQUARK_FAKEPAD: virtual gamepad 045e:02fd reads %s\n", path);
+}
+
