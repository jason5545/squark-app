+static inline unsigned int waitlog_flags( DWORD count, BOOL all, BOOLEAN alertable, const LARGE_INTEGER *timeout )
+{
+    unsigned int flags = (count < WAITLOG_F_COUNT ? count : WAITLOG_F_COUNT);
