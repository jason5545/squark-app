+extern ULONGLONG waitlog_begin( unsigned int kind, ULONG_PTR obj );
+extern void waitlog_end( ULONGLONG start, unsigned int kind, unsigned int flags, ULONG_PTR obj,
+                         unsigned int status, unsigned int waker );
