+    WAITLOG_SIGNAL_AND_WAIT,       /* obj = handle waited on */
+    WAITLOG_KEYED_WAIT,            /* obj = key */
+    WAITLOG_KEYED_RELEASE,         /* obj = key */
+    WAITLOG_DELAY,                 /* Sleep(n): obj = timeout (100 ns, negative is relative) */
