+#define WAITLOG_F_ALL       0x0080  /* WaitAll */
+#define WAITLOG_F_ALERTABLE 0x0100
+#define WAITLOG_F_TIMEOUT   0x0200  /* a finite timeout was given */
+#define WAITLOG_F_POLL      0x0400  /* zero timeout */
+#define WAITLOG_F_NOBLOCK   0x0800  /* alert wait: the alert was already there */
+#define WAITLOG_F_OPEN      0x1000  /* still waiting when the window ended */
+
+#define WAITLOG_WAKER_IMMEDIATE 1   /* server wait satisfied by the select request itself */
+
+enum waitlog_state
+{
+    WAITLOG_STATE_OFF = 0,
+    WAITLOG_STATE_RECORDING,
+    WAITLOG_STATE_STOPPED,
+    WAITLOG_STATE_GATHER,
+    WAITLOG_STATE_GATHERING,
+    WAITLOG_STATE_GATHERED,
