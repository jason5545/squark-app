+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Off unless the directory $WINEPREFIX/squark-waitlog (or $SQUARK_WAITLOG_DIR) exists when a
+ * process starts. Then a thread of this file watches that directory with kqueue, sleeping
+ * until a file in it changes. Writing a file "ctl" there (see parse_ctl) starts a window of a
+ * few seconds in each matching process. While it is off, every instrumented wait costs one
+ * load of waitlog_state; the events of a window go to memory allocated up front and are
+ * written out only after the window, by this thread.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#ifdef __APPLE__
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/event.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "wine/server.h"
+#include "wine/debug.h"
+#include "unix_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(sync);
+
+int waitlog_state;  /* WAITLOG_STATE_*; read on every instrumented wait */
+
+#define WL_MAX_TIDX      65536    /* Windows thread ids up to 4 * this are tracked per thread */
+#define WL_MAX_OBJS      8192
+#define WL_MAX_THREADS   4096
+#define WL_STRINGS       (1 << 20)
+
+struct waitlog_event
+{
+    ULONGLONG start;   /* mach_absolute_time() */
+    ULONGLONG end;
+    ULONGLONG obj;     /* handle, address hint, key, target thread id, timeout or yield count */
+    UINT      tid;     /* Windows thread id of the thread that waited or acted */
+    UINT      waker;   /* WAITLOG_WAKER_* or a thread id, see the README */
+    UINT      status;  /* what the call returned */
+    USHORT    kind;    /* WAITLOG_*, written last */
+    USHORT    flags;   /* WAITLOG_F_* */
+};
+C_ASSERT( sizeof(struct waitlog_event) == 40 );
+
+struct wl_thread
+{
+    ULONGLONG wait_start;  /* wait in progress, 0 if none (exchanged by its owner or the stop scan) */
+    ULONGLONG wait_obj;
+    ULONGLONG ystart;      /* run of yields in progress */
+    ULONGLONG yend;
+    UINT      ycount;
+    USHORT    wait_kind;
+    USHORT    wait_flags;
+    UINT      alerter;     /* last thread that alerted this one */
+    UINT      port;        /* Mach port name of the thread, once it logged something */
+    ULONGLONG mach_id;     /* pthread_threadid_np(), the "Thread_<n>" of sample(1) */
+};
+
+struct wl_snap
+{
+    UINT      port;
+    UINT      run_state;
+    ULONGLONG mach_id;
+    ULONGLONG cpu_us;
+    char      name[64];
+};
+
+struct wl_tinfo
+{
+    UINT      tid;
+    UINT      port;
+    UINT      order;
+    UINT      name;        /* offset in strings, 0 if none */
+    ULONGLONG entry;
+};
+
+struct wl_obj
+{
+    ULONGLONG handle;
+    UINT      type;        /* offsets in strings */
+    UINT      name;
+};
+
+static struct
+{
+    struct waitlog_event *events;
+    ULONGLONG capacity;
+    ULONGLONG count;
+    struct wl_thread *threads;
+    ULONGLONG t_on, t0, t1;
+    ULONGLONG yield_gap;
+    struct wl_snap *snap0, *snap1;
+    unsigned int nsnap0, nsnap1;
+    struct wl_tinfo *tinfo;
+    unsigned int ntinfo;
+    struct wl_obj *objs;
+    unsigned int nobjs;
+    char *strings;
+    unsigned int strings_used;
+    int gathered;
+    int open_waits, open_yields;
+} wl;
+
+static char wl_dir[1024];
+static char wl_exe[260];
+static UINT wl_wine_pid;
+static mach_timebase_info_data_t wl_timebase;
+
+static inline ULONGLONG wl_now(void)
+{
+    return mach_absolute_time();
+}
+
+static struct wl_thread *wl_self( UINT *tid_ret )
+{
+    struct thread_data *data = get_thread_data();
+    UINT tid, idx;
+
+    *tid_ret = 0;
+    if (!data) return NULL;
+    tid = data->tid;
+    *tid_ret = tid;
+    idx = tid >> 2;
+    if (idx >= WL_MAX_TIDX || !wl.threads) return NULL;
+    return &wl.threads[idx];
+}
+
+static void wl_register( struct wl_thread *t )
+{
+    uint64_t id = 0;
+
+    if (t->port) return;
+    pthread_threadid_np( NULL, &id );
+    t->mach_id = id;
+    t->port = pthread_mach_thread_np( pthread_self() );
+}
+
+static void wl_append( ULONGLONG start, ULONGLONG end, ULONGLONG obj, UINT tid, UINT waker,
+                       UINT status, USHORT kind, USHORT flags )
+{
+    ULONGLONG i = __atomic_fetch_add( &wl.count, 1, __ATOMIC_RELAXED );
+    struct waitlog_event *e;
+
+    if (i >= wl.capacity) return;
+    e = &wl.events[i];
+    e->start = start;
+    e->end = end;
+    e->obj = obj;
+    e->tid = tid;
+    e->waker = waker;
+    e->status = status;
+    e->flags = flags;
+    __atomic_store_n( &e->kind, kind, __ATOMIC_RELEASE );
+}
+
+static void wl_flush_yields( struct wl_thread *t, UINT tid )
+{
+    UINT count = __atomic_exchange_n( &t->ycount, 0, __ATOMIC_SEQ_CST );
+
+    if (count) wl_append( t->ystart, t->yend, count, tid, 0, 0, WAITLOG_YIELD, 0 );
+}
+
+static BOOL wl_blocking_kind( unsigned int kind )
+{
+    switch (kind)
+    {
+    case WAITLOG_SET_EVENT:
+    case WAITLOG_PULSE_EVENT:
+    case WAITLOG_RELEASE_SEMAPHORE:
+    case WAITLOG_RELEASE_MUTANT:
+    case WAITLOG_ALERT_SEND:
+    case WAITLOG_YIELD:
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void wl_gather(void);
+
+/* slow path of waitlog_start(): returns the start time while recording, else 0 */
+ULONGLONG waitlog_begin( unsigned int kind, ULONG_PTR obj )
+{
+    int state = __atomic_load_n( &waitlog_state, __ATOMIC_ACQUIRE );
+    struct wl_thread *t;
+    ULONGLONG now;
+    UINT tid;
+
+    if (state == WAITLOG_STATE_RECORDING)
+    {
+        now = wl_now();
+        if ((t = wl_self( &tid )))
+        {
+            wl_register( t );
+            if (wl_blocking_kind( kind ))
+            {
+                t->wait_kind = kind;
+                t->wait_obj = obj;
+                __atomic_store_n( &t->wait_start, now, __ATOMIC_SEQ_CST );
+            }
+        }
+        return now;
+    }
+    if (state == WAITLOG_STATE_GATHER && wl_blocking_kind( kind ) &&
+        __sync_bool_compare_and_swap( &waitlog_state, WAITLOG_STATE_GATHER, WAITLOG_STATE_GATHERING ))
+    {
+        /* on a Windows thread, before it waits: names of threads and objects need the server */
+        wl_gather();
+        __atomic_store_n( &waitlog_state, WAITLOG_STATE_GATHERED, __ATOMIC_RELEASE );
+    }
+    return 0;
+}
+
+void waitlog_end( ULONGLONG start, unsigned int kind, unsigned int flags, ULONG_PTR obj,
+                  unsigned int status, unsigned int waker )
+{
+    ULONGLONG end = wl_now();
+    UINT tid;
+    struct wl_thread *t = wl_self( &tid );
+    int state;
+
+    if (t)
+    {
+        if (wl_blocking_kind( kind ) && !__atomic_exchange_n( &t->wait_start, 0, __ATOMIC_SEQ_CST ))
+            return;  /* the stop scan wrote it as a wait still open at the end of the window */
+        if (t->ycount) wl_flush_yields( t, tid );
+    }
+    state = __atomic_load_n( &waitlog_state, __ATOMIC_SEQ_CST );
+    if (state != WAITLOG_STATE_RECORDING && state != WAITLOG_STATE_STOPPED) return;
+    wl_append( start, end, obj, tid, waker, status, kind, flags );
+}
+
+/* NtYieldExecution, Sleep(0): runs of them closer than yield_gap become one event */
+void waitlog_yield( ULONGLONG start )
+{
+    ULONGLONG end = wl_now();
+    struct wl_thread *t;
+    UINT tid;
+
+    if (!(t = wl_self( &tid ))) return;
+    if (t->ycount && start - t->yend <= wl.yield_gap)
+    {
+        t->yend = end;
+        t->ycount++;
+        return;
+    }
+    if (t->ycount) wl_flush_yields( t, tid );
+    t->ystart = start;
+    t->yend = end;
+    __atomic_store_n( &t->ycount, 1, __ATOMIC_SEQ_CST );
+}
+
+void waitlog_alert_sent( HANDLE target )
+{
+    UINT tid, idx = HandleToULong( target ) >> 2;
+    struct wl_thread *t;
+    ULONGLONG now;
+
+    int state = __atomic_load_n( &waitlog_state, __ATOMIC_ACQUIRE );
+
+    /* after the window a wait that began in it may still end: it gets its waker too */
+    if (state != WAITLOG_STATE_RECORDING && state != WAITLOG_STATE_STOPPED) return;
+    now = wl_now();
+    if ((t = wl_self( &tid ))) wl_register( t );
+    if (idx < WL_MAX_TIDX) __atomic_store_n( &wl.threads[idx].alerter, tid, __ATOMIC_RELEASE );
+    wl_append( now, now, HandleToULong( target ), tid, 0, 0, WAITLOG_ALERT_SEND, 0 );
+}
+
+unsigned int waitlog_take_alerter(void)
+{
+    struct wl_thread *t;
+    UINT tid;
+
+    if (!(t = wl_self( &tid ))) return 0;
+    return __atomic_exchange_n( &t->alerter, 0, __ATOMIC_ACQUIRE );
+}
+
+
+/* strings, gathered data */
+
+static UINT wl_strdup( const char *s, size_t len )
+{
+    UINT off;
+
+    if (!len || wl.strings_used + len + 1 > WL_STRINGS) return 0;
+    off = wl.strings_used;
+    memcpy( wl.strings + off, s, len );
+    wl.strings[off + len] = 0;
+    wl.strings_used += len + 1;
+    return off;
+}
+
+static UINT wl_strdupw( const WCHAR *s, size_t len )
+{
+    char buf[512];
+    size_t i, n = 0;
+
+    for (i = 0; i < len && n < sizeof(buf) - 4; i++)
+    {
+        unsigned int c = s[i];
+        if (c >= 0xd800 && c < 0xdc00 && i + 1 < len && s[i + 1] >= 0xdc00 && s[i + 1] < 0xe000)
+        {
+            c = 0x10000 + ((c - 0xd800) << 10) + (s[i + 1] - 0xdc00);
+            i++;
+        }
+        if (c < 0x80) buf[n++] = c;
+        else if (c < 0x800) { buf[n++] = 0xc0 | (c >> 6); buf[n++] = 0x80 | (c & 0x3f); }
+        else if (c < 0x10000)
+        {
+            buf[n++] = 0xe0 | (c >> 12); buf[n++] = 0x80 | ((c >> 6) & 0x3f); buf[n++] = 0x80 | (c & 0x3f);
+        }
+        else
+        {
+            buf[n++] = 0xf0 | (c >> 18); buf[n++] = 0x80 | ((c >> 12) & 0x3f);
+            buf[n++] = 0x80 | ((c >> 6) & 0x3f); buf[n++] = 0x80 | (c & 0x3f);
+        }
+    }
+    return wl_strdup( buf, n );
+}
+
+static BOOL wl_handle_kind( unsigned int kind )
+{
+    switch (kind)
+    {
+    case WAITLOG_SERVER_WAIT:
+    case WAITLOG_SIGNAL_AND_WAIT:
+    case WAITLOG_IO_COMPLETION:
+    case WAITLOG_SET_EVENT:
+    case WAITLOG_PULSE_EVENT:
+    case WAITLOG_RELEASE_SEMAPHORE:
+    case WAITLOG_RELEASE_MUTANT:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void wl_add_obj( ULONGLONG handle )
+{
+    static ULONGLONG hash[WL_MAX_OBJS * 2];
+    unsigned int i, h = (unsigned int)((handle >> 2) * 2654435761u) % (WL_MAX_OBJS * 2);
+
+    if (!handle) { memset( hash, 0, sizeof(hash) ); return; }  /* reset */
+    if ((LONG_PTR)handle < 0 || wl.nobjs >= WL_MAX_OBJS) return;  /* pseudo handles */
+    for (i = 0; i < WL_MAX_OBJS * 2; i++, h = (h + 1) % (WL_MAX_OBJS * 2))
+    {
+        if (hash[h] == handle) return;
+        if (!hash[h]) break;
+    }
+    if (i == WL_MAX_OBJS * 2) return;
+    hash[h] = handle;
+    wl.objs[wl.nobjs++].handle = handle;
+}
+
+static void wl_gather(void)
+{
+    ULONGLONG i, n = wl.count < wl.capacity ? wl.count : wl.capacity;
+    size_t size = 1 << 20;
+    char *buffer = malloc( size );
+    union { THREAD_NAME_INFORMATION ti; OBJECT_TYPE_INFORMATION oti; OBJECT_NAME_INFORMATION oni; char b[2048]; } info;
+    unsigned int status, j, k, process_count = 0, pos = 0;
+    pid_t self = getpid();
+    ULONG len;
+
+    wl.ntinfo = 0;
+    wl.nobjs = 0;
+    if (!buffer) return;
+
+    /* threads of this process: their Windows ids, Mach port names (unix_tid on macOS) and names */
+    SERVER_START_REQ( list_processes )
+    {
+        wine_server_set_reply( req, buffer, size );
+        status = wine_server_call( req );
+        process_count = reply->process_count;
+    }
+    SERVER_END_REQ;
+    for (j = 0; !status && j < process_count; j++)
+    {
+        const struct process_info *p;
+
+        pos = (pos + 7) & ~7;
+        p = (const struct process_info *)(buffer + pos);
+        pos += sizeof(*p) + p->name_len;
+        pos = (pos + 7) & ~7;
+        for (k = 0; k < (unsigned int)p->thread_count; k++)
+        {
+            const struct thread_info *t = (const struct thread_info *)(buffer + pos);
+
+            pos += sizeof(*t);
+            if (p->unix_pid != self || wl.ntinfo >= WL_MAX_THREADS) continue;
+            wl.tinfo[wl.ntinfo].tid = t->tid;
+            wl.tinfo[wl.ntinfo].port = t->unix_tid;
+            wl.tinfo[wl.ntinfo].order = k;
+            wl.tinfo[wl.ntinfo].entry = t->entry_point;
+            wl.tinfo[wl.ntinfo].name = 0;
+            wl.ntinfo++;
+        }
+    }
+    free( buffer );
+
+    for (j = 0; j < wl.ntinfo; j++)
+    {
+        OBJECT_ATTRIBUTES attr;
+        CLIENT_ID cid;
+        HANDLE handle;
+
+        InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+        cid.UniqueProcess = 0;
+        cid.UniqueThread = ULongToHandle( wl.tinfo[j].tid );
+        if (NtOpenThread( &handle, THREAD_QUERY_LIMITED_INFORMATION, &attr, &cid )) continue;
+        if (!NtQueryInformationThread( handle, ThreadNameInformation, &info, sizeof(info), &len ) &&
+            info.ti.ThreadName.Length)
+            wl.tinfo[j].name = wl_strdupw( info.ti.ThreadName.Buffer, info.ti.ThreadName.Length / sizeof(WCHAR) );
+        NtClose( handle );
+    }
+
+    /* objects the window waited on or signaled */
+    wl_add_obj( 0 );
+    for (i = 0; i < n; i++)
+        if (wl_handle_kind( wl.events[i].kind )) wl_add_obj( wl.events[i].obj );
+    for (j = 0; j < wl.nobjs; j++)
+    {
+        HANDLE handle = (HANDLE)(ULONG_PTR)wl.objs[j].handle;
+
+        wl.objs[j].type = wl.objs[j].name = 0;
+        if (!NtQueryObject( handle, ObjectTypeInformation, &info, sizeof(info), &len ))
+            wl.objs[j].type = wl_strdupw( info.oti.TypeName.Buffer, info.oti.TypeName.Length / sizeof(WCHAR) );
+        if (!NtQueryObject( handle, ObjectNameInformation, &info, sizeof(info), &len ) && info.oni.Name.Length)
+            wl.objs[j].name = wl_strdupw( info.oni.Name.Buffer, info.oni.Name.Length / sizeof(WCHAR) );
+    }
+    wl.gathered = 1;
+}
+
+
+/* the watcher thread */
+
+static unsigned int wl_snapshot( struct wl_snap *snap, unsigned int max )
+{
+    thread_act_array_t list;
+    mach_msg_type_number_t count, i;
+    unsigned int n = 0;
+
+    if (task_threads( mach_task_self(), &list, &count ) != KERN_SUCCESS) return 0;
+    for (i = 0; i < count; i++)
+    {
+        thread_basic_info_data_t basic;
+        thread_identifier_info_data_t ident;
+        thread_extended_info_data_t ext;
+        mach_msg_type_number_t c;
+
+        if (n < max)
+        {
+            memset( &snap[n], 0, sizeof(snap[n]) );
+            snap[n].port = list[i];
+            c = THREAD_BASIC_INFO_COUNT;
+            if (!thread_info( list[i], THREAD_BASIC_INFO, (thread_info_t)&basic, &c ))
+            {
+                snap[n].cpu_us = basic.user_time.seconds * 1000000ull + basic.user_time.microseconds +
+                                 basic.system_time.seconds * 1000000ull + basic.system_time.microseconds;
+                snap[n].run_state = basic.run_state;
+            }
+            c = THREAD_IDENTIFIER_INFO_COUNT;
+            if (!thread_info( list[i], THREAD_IDENTIFIER_INFO, (thread_info_t)&ident, &c ))
+                snap[n].mach_id = ident.thread_id;
+            c = THREAD_EXTENDED_INFO_COUNT;
+            if (!thread_info( list[i], THREAD_EXTENDED_INFO, (thread_info_t)&ext, &c ))
+            {
+                memcpy( snap[n].name, ext.pth_name, sizeof(snap[n].name) - 1 );
+                snap[n].name[sizeof(snap[n].name) - 1] = 0;
+            }
+            n++;
+        }
+        mach_port_deallocate( mach_task_self(), list[i] );
+    }
+    vm_deallocate( mach_task_self(), (vm_address_t)list, count * sizeof(list[0]) );
+    return n;
+}
+
+struct wl_params
+{
+    char      id[64];
+    char      exe[260];
+    char      out[1024];
+    double    seconds;
+    double    warmup;
+    ULONGLONG events;
+    ULONGLONG yield_gap_us;
+};
+
+static void wl_trim( char *s )
+{
+    char *p = s + strlen( s );
+    while (p > s && (p[-1] == ' ' || p[-1] == '\t' || p[-1] == '\r')) *--p = 0;
+}
+
+/* ctl: key=value lines. id (required, a new one starts a window), exe (base name of the process,
+ * case-insensitive, or * for any; default *), seconds (default 10), warmup (default 0.5),
+ * events (buffer size, default 2000000), yieldgap_us (default 100), out (directory, default the
+ * control directory) */
+static BOOL wl_parse_ctl( struct wl_params *p )
+{
+    char path[1100], buf[4096], *line, *next;
+    int fd;
+    ssize_t len;
+
+    memset( p, 0, sizeof(*p) );
+    strcpy( p->exe, "*" );
+    p->seconds = 10;
+    p->warmup = 0.5;
+    p->events = 2000000;
+    p->yield_gap_us = 100;
+    snprintf( p->out, sizeof(p->out), "%s", wl_dir );
+
+    snprintf( path, sizeof(path), "%s/ctl", wl_dir );
+    if ((fd = open( path, O_RDONLY )) == -1) return FALSE;
+    len = read( fd, buf, sizeof(buf) - 1 );
+    close( fd );
+    if (len <= 0) return FALSE;
+    buf[len] = 0;
+    for (line = buf; line; line = next)
+    {
+        char *eq;
+
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        wl_trim( line );
+        if (!(eq = strchr( line, '=' ))) continue;
+        *eq++ = 0;
+        if (!strcmp( line, "id" )) snprintf( p->id, sizeof(p->id), "%s", eq );
+        else if (!strcmp( line, "exe" )) snprintf( p->exe, sizeof(p->exe), "%s", eq );
+        else if (!strcmp( line, "out" )) snprintf( p->out, sizeof(p->out), "%s", eq );
+        else if (!strcmp( line, "seconds" )) p->seconds = atof( eq );
+        else if (!strcmp( line, "warmup" )) p->warmup = atof( eq );
+        else if (!strcmp( line, "events" )) p->events = strtoull( eq, NULL, 10 );
+        else if (!strcmp( line, "yieldgap_us" )) p->yield_gap_us = strtoull( eq, NULL, 10 );
+    }
+    for (line = p->id; *line; line++)
+        if (!((*line >= '0' && *line <= '9') || (*line >= 'a' && *line <= 'z') || (*line >= 'A' && *line <= 'Z') ||
+              *line == '-' || *line == '_' || *line == '.')) *line = '_';
+    if (p->seconds <= 0 || p->seconds > 600) p->seconds = 10;
+    if (p->warmup < 0 || p->warmup > 60) p->warmup = 0.5;
+    if (p->events < 1000) p->events = 1000;
+    if (p->events > 50000000) p->events = 50000000;
+    return p->id[0] != 0;
+}
+
+static void wl_exe_name(void)
+{
+    const UNICODE_STRING *path;
+    const WCHAR *s;
+    size_t i, n, start = 0;
+
+    if (wl_exe[0] || !peb || !peb->ProcessParameters) return;
+    path = &peb->ProcessParameters->ImagePathName;
+    if (!path->Buffer) return;
+    s = path->Buffer;
+    n = path->Length / sizeof(WCHAR);
+    for (i = 0; i < n; i++) if (s[i] == '\\' || s[i] == '/') start = i + 1;
+    for (i = start, n = (n - start < sizeof(wl_exe) - 1) ? n : start + sizeof(wl_exe) - 1; i < n; i++)
+        wl_exe[i - start] = (s[i] < 0x80 && s[i] > 0x20) ? s[i] : '_';
+    wl_exe[n - start] = 0;
+}
+
+static void wl_sleep_until( ULONGLONG deadline )
+{
+    for (;;)
+    {
+        ULONGLONG now = wl_now(), ns;
+        struct timespec ts;
+
+        if (now >= deadline) return;
+        ns = (deadline - now) * wl_timebase.numer / wl_timebase.denom;
+        ts.tv_sec = ns / 1000000000;
+        ts.tv_nsec = ns % 1000000000;
+        nanosleep( &ts, NULL );
+    }
+}
+
+static ULONGLONG wl_ticks( double seconds )
+{
+    return (ULONGLONG)(seconds * 1e9 * wl_timebase.denom / wl_timebase.numer);
+}
+
+static void wl_json_str( FILE *f, const char *s )
+{
+    fputc( '"', f );
+    for (; s && *s; s++)
+    {
+        unsigned char c = *s;
+        if (c == '"' || c == '\\') fprintf( f, "\\%c", c );
+        else if (c < 0x20) fprintf( f, "\\u%04x", c );
+        else fputc( c, f );
+    }
+    fputc( '"', f );
+}
+
+static void wl_write( const struct wl_params *p, ULONGLONG wall_on_us, const char *err )
+{
+    char base[1500], path[1600], tmp[1700];
+    ULONGLONG i, n = wl.count < wl.capacity ? wl.count : wl.capacity;
+    unsigned int j;
+    FILE *f;
+    int fd;
+
+    snprintf( base, sizeof(base), "%s/waitlog-%s-%s-%d", p->out, p->id, wl_exe, (int)getpid() );
+    if (!err)
+    {
+        snprintf( path, sizeof(path), "%s.events", base );
+        if ((fd = open( path, O_WRONLY | O_CREAT | O_TRUNC, 0644 )) != -1)
+        {
+            const char *ptr = (const char *)wl.events;
+            size_t left = n * sizeof(struct waitlog_event);
+            while (left)
+            {
+                ssize_t r = write( fd, ptr, left > (1 << 24) ? (1 << 24) : left );
+                if (r <= 0) break;
+                ptr += r;
+                left -= r;
+            }
+            close( fd );
+        }
+    }
+    snprintf( tmp, sizeof(tmp), "%s.json.tmp", base );
+    if (!(f = fopen( tmp, "w" ))) return;
+    fprintf( f, "{\n \"version\": 1,\n \"id\": " );
+    wl_json_str( f, p->id );
+    fprintf( f, ",\n \"exe\": " );
+    wl_json_str( f, wl_exe );
+    fprintf( f, ",\n \"pid\": %d,\n \"wine_pid\": %u,\n", (int)getpid(), wl_wine_pid );
+    if (err)
+    {
+        fprintf( f, " \"error\": " );
+        wl_json_str( f, err );
+        fprintf( f, "\n}\n" );
+        fclose( f );
+        snprintf( path, sizeof(path), "%s.json", base );
+        rename( tmp, path );
+        return;
+    }
+    fprintf( f, " \"timebase\": [%u, %u],\n", wl_timebase.numer, wl_timebase.denom );
+    fprintf( f, " \"t_on\": %llu,\n \"t0\": %llu,\n \"t1\": %llu,\n \"wall_on_us\": %llu,\n",
+             (unsigned long long)wl.t_on, (unsigned long long)wl.t0, (unsigned long long)wl.t1,
+             (unsigned long long)wall_on_us );
+    fprintf( f, " \"seconds\": %g,\n \"warmup\": %g,\n \"yield_gap_us\": %llu,\n", p->seconds, p->warmup,
+             (unsigned long long)p->yield_gap_us );
+    fprintf( f, " \"capacity\": %llu,\n \"appended\": %llu,\n \"events\": %llu,\n \"event_size\": %u,\n",
+             (unsigned long long)wl.capacity, (unsigned long long)wl.count, (unsigned long long)n,
+             (unsigned int)sizeof(struct waitlog_event) );
+    fprintf( f, " \"open_waits\": %d,\n \"open_yields\": %d,\n \"gathered\": %s,\n", wl.open_waits,
+             wl.open_yields, wl.gathered ? "true" : "false" );
+    fprintf( f, " \"threads\": [" );
+    for (j = 0; j < wl.ntinfo; j++)
+    {
+        fprintf( f, "%s\n  {\"tid\": %u, \"port\": %u, \"order\": %u, \"entry\": \"0x%llx\", \"name\": ", j ? "," : "",
+                 wl.tinfo[j].tid, wl.tinfo[j].port, wl.tinfo[j].order, (unsigned long long)wl.tinfo[j].entry );
+        wl_json_str( f, wl.tinfo[j].name ? wl.strings + wl.tinfo[j].name : "" );
+        fputc( '}', f );
+    }
+    fprintf( f, "\n ],\n \"logged\": [" );
+    for (i = 0, j = 0; i < WL_MAX_TIDX; i++)
+    {
+        if (!wl.threads[i].port) continue;
+        fprintf( f, "%s\n  {\"tid\": %u, \"port\": %u, \"mach_id\": %llu}", j++ ? "," : "", (unsigned int)(i << 2),
+                 wl.threads[i].port, (unsigned long long)wl.threads[i].mach_id );
+    }
+    fprintf( f, "\n ],\n \"mach\": [" );
+    for (j = 0; j < wl.nsnap1; j++)
+    {
+        unsigned int k;
+        long long cpu0 = -1;
+
+        for (k = 0; k < wl.nsnap0; k++)
+            if (wl.snap0[k].mach_id == wl.snap1[j].mach_id) { cpu0 = wl.snap0[k].cpu_us; break; }
+        fprintf( f, "%s\n  {\"port\": %u, \"mach_id\": %llu, \"cpu0_us\": %lld, \"cpu1_us\": %llu, \"run_state\": %u, \"pthread\": ",
+                 j ? "," : "", wl.snap1[j].port, (unsigned long long)wl.snap1[j].mach_id, cpu0,
+                 (unsigned long long)wl.snap1[j].cpu_us, wl.snap1[j].run_state );
+        wl_json_str( f, wl.snap1[j].name );
+        fputc( '}', f );
+    }
+    fprintf( f, "\n ],\n \"objects\": [" );
+    for (j = 0; j < wl.nobjs; j++)
+    {
+        fprintf( f, "%s\n  {\"handle\": \"0x%llx\", \"type\": ", j ? "," : "", (unsigned long long)wl.objs[j].handle );
+        wl_json_str( f, wl.objs[j].type ? wl.strings + wl.objs[j].type : "" );
+        fprintf( f, ", \"name\": " );
+        wl_json_str( f, wl.objs[j].name ? wl.strings + wl.objs[j].name : "" );
+        fputc( '}', f );
+    }
+    fprintf( f, "\n ]\n}\n" );
+    fclose( f );
+    snprintf( path, sizeof(path), "%s.json", base );
+    rename( tmp, path );
+}
+
+static void *wl_map( size_t size )
+{
+    void *ptr = mmap( NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0 );
+    return ptr == MAP_FAILED ? NULL : ptr;
+}
+
+static void wl_session( const struct wl_params *p )
+{
+    static ULONGLONG mapped_events;
+    struct timeval tv;
+    ULONGLONG wall_on_us, deadline, i;
+    int tries;
+
+    /* Buffers stay mapped between windows: a thread still finishing a wait of the last window
+     * may write to them after they were written out. */
+    if (!wl.threads)
+    {
+        wl.threads = wl_map( WL_MAX_TIDX * sizeof(*wl.threads) );
+        wl.snap0 = wl_map( WL_MAX_THREADS * sizeof(*wl.snap0) );
+        wl.snap1 = wl_map( WL_MAX_THREADS * sizeof(*wl.snap1) );
+        wl.tinfo = wl_map( WL_MAX_THREADS * sizeof(*wl.tinfo) );
+        wl.objs = wl_map( WL_MAX_OBJS * sizeof(*wl.objs) );
+        wl.strings = wl_map( WL_STRINGS );
+        if (!wl.threads || !wl.snap0 || !wl.snap1 || !wl.tinfo || !wl.objs || !wl.strings)
+        {
+            wl.threads = NULL;
+            wl_write( p, 0, "out of memory" );
+            return;
+        }
+    }
+    if (p->events > mapped_events)
+    {
+        struct waitlog_event *events = wl_map( p->events * sizeof(*events) );
+        if (!events)
+        {
+            wl_write( p, 0, "cannot allocate the event buffer" );
+            return;
+        }
+        if (wl.events) munmap( wl.events, mapped_events * sizeof(*events) );
+        wl.events = events;
+        mapped_events = p->events;
+    }
+    else memset( wl.events, 0, p->events * sizeof(*wl.events) );
+    memset( wl.threads, 0, WL_MAX_TIDX * sizeof(*wl.threads) );
+    wl.capacity = p->events;
+    wl.count = 0;
+    wl.yield_gap = wl_ticks( p->yield_gap_us / 1e6 );
+    wl.strings_used = 1;
+    wl.gathered = wl.open_waits = wl.open_yields = 0;
+    wl.ntinfo = wl.nobjs = 0;
+
+    gettimeofday( &tv, NULL );
+    wall_on_us = tv.tv_sec * 1000000ull + tv.tv_usec;
+    wl.t_on = wl_now();
+    __atomic_store_n( &waitlog_state, WAITLOG_STATE_RECORDING, __ATOMIC_SEQ_CST );
+
+    /* waits that began before the recording started are lost: the warmup keeps them out of the window */
+    wl.t0 = wl.t_on + wl_ticks( p->warmup );
+    wl_sleep_until( wl.t0 );
+    wl.nsnap0 = wl_snapshot( wl.snap0, WL_MAX_THREADS );
+    deadline = wl.t0 + wl_ticks( p->seconds );
+    wl_sleep_until( deadline );
+
+    __atomic_store_n( &waitlog_state, WAITLOG_STATE_STOPPED, __ATOMIC_SEQ_CST );
+    wl.t1 = wl_now();
+    wl.nsnap1 = wl_snapshot( wl.snap1, WL_MAX_THREADS );
+
+    /* waits still in progress end at t1 */
+    for (i = 0; i < WL_MAX_TIDX; i++)
+    {
+        struct wl_thread *t = &wl.threads[i];
+        ULONGLONG start;
+        UINT count;
+
+        if (!t->port) continue;
+        if ((start = __atomic_exchange_n( &t->wait_start, 0, __ATOMIC_SEQ_CST )))
+        {
+            wl_append( start, wl.t1, t->wait_obj, i << 2, 0, STATUS_PENDING, t->wait_kind, WAITLOG_F_OPEN );
+            wl.open_waits++;
+        }
+        if ((count = __atomic_exchange_n( &t->ycount, 0, __ATOMIC_SEQ_CST )))
+        {
+            wl_append( t->ystart, t->yend, count, i << 2, 0, 0, WAITLOG_YIELD, WAITLOG_F_OPEN );
+            wl.open_yields++;
+        }
+    }
+
+    /* let a Windows thread look up thread and object names, then stop */
+    usleep( 2000 );
+    __atomic_store_n( &waitlog_state, WAITLOG_STATE_GATHER, __ATOMIC_SEQ_CST );
+    for (tries = 0; tries < 600; tries++)
+    {
+        if (__atomic_load_n( &waitlog_state, __ATOMIC_ACQUIRE ) == WAITLOG_STATE_GATHERED) break;
+        usleep( 5000 );
+    }
+    if (!__sync_bool_compare_and_swap( &waitlog_state, WAITLOG_STATE_GATHER, WAITLOG_STATE_OFF ))
+    {
+        /* a thread is gathering or done: wait for it */
+        while (__atomic_load_n( &waitlog_state, __ATOMIC_ACQUIRE ) == WAITLOG_STATE_GATHERING) usleep( 1000 );
+        __atomic_store_n( &waitlog_state, WAITLOG_STATE_OFF, __ATOMIC_SEQ_CST );
+    }
+    wl_write( p, wall_on_us, NULL );
+}
+
+static BOOL wl_exe_matches( const char *pattern )
+{
+    if (!strcmp( pattern, "*" )) return TRUE;
+    wl_exe_name();
+    return !strcasecmp( pattern, wl_exe );
+}
+
+static void *wl_watcher( void *arg )
+{
+    char last_id[64] = "";
+    struct wl_params p;
+    struct kevent ev, out;
+    int kq, dirfd;
+
+    mach_timebase_info( &wl_timebase );
+    if ((dirfd = open( wl_dir, O_EVTONLY )) == -1) return NULL;
+    if ((kq = kqueue()) == -1)
+    {
+        close( dirfd );
+        return NULL;
+    }
+    EV_SET( &ev, dirfd, EVFILT_VNODE, EV_ADD | EV_CLEAR, NOTE_WRITE | NOTE_DELETE | NOTE_RENAME | NOTE_REVOKE, 0, 0 );
+    if (kevent( kq, &ev, 1, NULL, 0, NULL ) == -1) goto done;
+
+    /* a ctl from before this process started is not for it */
+    if (wl_parse_ctl( &p )) strcpy( last_id, p.id );
+
+    for (;;)
+    {
+        int r = kevent( kq, NULL, 0, &out, 1, NULL );
+
+        if (r == -1 && errno == EINTR) continue;
+        if (r <= 0) break;
+        if (out.fflags & (NOTE_DELETE | NOTE_RENAME | NOTE_REVOKE)) break;
+        if (!wl_parse_ctl( &p ) || !strcmp( p.id, last_id )) continue;
+        strcpy( last_id, p.id );
+        if (!wl_exe_matches( p.exe )) continue;
+        wl_exe_name();
+        wl_session( &p );
+    }
+done:
+    close( kq );
+    close( dirfd );
+    return NULL;
+}
+
+/* called once per process, from server_init_process_done() */
+void waitlog_init(void)
+{
+    const char *env = getenv( "SQUARK_WAITLOG_DIR" );
+    struct thread_data *data = get_thread_data();
+    pthread_attr_t attr;
+    pthread_t thread;
+    sigset_t all, old;
+    struct stat st;
+
+    if (data && data->teb) wl_wine_pid = HandleToULong( data->teb->ClientId.UniqueProcess );
+    if (env && *env) snprintf( wl_dir, sizeof(wl_dir), "%s", env );
+    else if (config_dir) snprintf( wl_dir, sizeof(wl_dir), "%s/squark-waitlog", config_dir );
+    else return;
+    if (stat( wl_dir, &st ) == -1 || !S_ISDIR( st.st_mode )) return;
+
+    /* the watcher is no Windows thread: no Wine signal may land on it */
+    sigfillset( &all );
+    pthread_sigmask( SIG_SETMASK, &all, &old );
+    pthread_attr_init( &attr );
+    pthread_attr_setdetachstate( &attr, PTHREAD_CREATE_DETACHED );
+    pthread_attr_setstacksize( &attr, 256 * 1024 );
+    if (!pthread_create( &thread, &attr, wl_watcher, NULL ))
+        TRACE( "watching %s\n", debugstr_a(wl_dir) );
+    pthread_attr_destroy( &attr );
