+/***********************************************************************
+ *              macdrv_background_mode
+ *
+ * HADRON_MAC_BACKGROUND=1 runs the program in the background for automated
+ * testing while someone else uses the Mac: it never activates itself or
+ * unhides, its windows sit at the lowest window level (under the desktop, so
+ * nothing of them shows, yet they stay on screen: they keep drawing and a
+ * window capture by id still works) and ignore the mouse, and it never warps,
+ * clips or reads the host cursor or changes a display mode. Input comes only
+ * from inside Wine (SendHardwareInput). Off by default.
+ */
+int macdrv_background_mode(void)
+{
+    static int mode = -1;
+
+    if (mode < 0)
+    {
+        const char *value = getenv("HADRON_MAC_BACKGROUND");
+        mode = value && value[0] && value[0] != '0';
+    }
+    return mode;
+}
+
