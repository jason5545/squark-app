+/* a due time as tp_set_timer() gets it, for WINEDEBUG=+tptimer */
+static const char *tptimer_dbgstr_due( const LARGE_INTEGER *timeout )
+{
+    LARGE_INTEGER now;
+    ULONGLONG a;
+    LONGLONG t;
+    const char *what;
 
+    if (!timeout) return "NULL (cancel)";
+    if (!(t = timeout->QuadPart)) return "0 (now)";
+    if (t > 0)
+    {
+        NtQuerySystemTime( &now );
+        t -= now.QuadPart;
+        what = "absolute, from now";
+    }
+    else what = "relative";
+    a = t < 0 ? -(ULONGLONG)t : (ULONGLONG)t;
+    if (a / 10000 > MAXLONG) return wine_dbg_sprintf( "%s %s (100 ns)", what, wine_dbgstr_longlong( t ) );
+    return wine_dbg_sprintf( "%s %s%lu.%04lu ms", what, t < 0 && timeout->QuadPart > 0 ? "-" : "",
+                             (ULONG)(a / 10000), (ULONG)(a % 10000) );
+}
+
 /***********************************************************************
+ *           tptimer_loop_diag         (internal)
+ *
+ * WINEDEBUG=+tptimer: counts the timer queue thread's rounds and prints them once a second.
+ * timerqueue.cs held by caller.
+ */
+static void tptimer_loop_diag( ULONGLONG rel_now, NTSTATUS woken_by )
+{
+    static ULONGLONG start;
+    static ULONG loops, by_rel, by_abs, by_other, no_rel;
+    ULONG nabs = 0, nrel = 0;
+    struct list *ptr;
+
+    loops++;
+    if (woken_by == STATUS_WAIT_0 + REL_TIMER) by_rel++;
+    else if (woken_by == STATUS_WAIT_0 + ABS_TIMER) by_abs++;
+    else by_other++;
+    if (list_empty( &timerqueue.rel_timers )) no_rel++;
+    if (!start) start = rel_now;
+    if (rel_now - start < 10000000) return;
+
+    LIST_FOR_EACH( ptr, &timerqueue.abs_timers ) nabs++;
+    LIST_FOR_EACH( ptr, &timerqueue.rel_timers ) nrel++;
+    TRACE_(tptimer)( "%lu ms: %lu rounds (woken by the relative timer %lu, the absolute one %lu, other %lu), "
+                     "%lu with no relative timer pending; %lu callbacks submitted; %ld timer objects, "
+                     "pending absolute %lu relative %lu\n", (ULONG)((rel_now - start) / 10000), loops, by_rel,
+                     by_abs, by_other, no_rel, tptimer_submitted, timerqueue.objcount, nabs, nrel );
+    start = rel_now;
+    loops = by_rel = by_abs = by_other = no_rel = tptimer_submitted = 0;
+}
+
