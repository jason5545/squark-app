 {
     struct semaphore *semaphore = get_shm( obj );
@@ -684,7 +770,7 @@ NTSTATUS msync_release_semaphore_obj( int obj, ULONG count, ULONG *prev_count )
 
     if (prev_count) *prev_count = current;
 
-    signal_all( (void *)semaphore, obj );
+    signal_waiters( (void *)semaphore, obj, count );
     return STATUS_SUCCESS;
 }
 
@@ -704,7 +790,8 @@ NTSTATUS msync_set_event_obj( int obj, LONG *prev_state )
     LONG current;
 
     if (!(current = __atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST )))
-        signal_all( (void *)event, obj );
+        signal_waiters( (void *)event, obj, (event->msync_type == MSYNC_AUTO_EVENT ||
+                                            event->msync_type == MSYNC_AUTO_SERVER) ? 1 : WAKE_ALL_WAITERS );
 
     if (prev_state) *prev_state = current;
 
@@ -769,7 +856,7 @@ NTSTATUS msync_release_mutex_obj( int obj, LONG *prev_count )
     if (!--mutex->count)
     {
