+                    if (status == STATUS_TIMEOUT) return STATUS_TIMEOUT;
+                    goto userapc;
+                }
             }
 
             /* If we got here and we haven't timed out, that means all of the
@@ -1102,6 +1198,9 @@ tryagain:
