diff --git a/dlls/ntdll/unix/msync.c b/dlls/ntdll/unix/msync.c
index d0fcb48..04abf4c 100644
--- a/dlls/ntdll/unix/msync.c
+++ b/dlls/ntdll/unix/msync.c
@@ -650,12 +650,58 @@ void msync_init(void)
     }
 }
 
-static inline void signal_all( void *shm, unsigned int shm_idx )
+/* Squark: an operation that frees one unit wakes one single-object waiter, not all of them.
+ *
+ * A thread that waits on one object without an alert object (msync_wait_single) sleeps in
+ * __ulock_wait on the object itself. Waking every one of them for each ReleaseSemaphore(1),
+ * SetEvent on an auto-reset event or ReleaseMutex let one take it and sent the others back to
+ * sleep: with 17 workers on one semaphore, 16 wasted wake-ups per job (records 25.72, 25.73).
+ * A release of more than one still wakes all of them (see signal_waiters).
+ *
+ * A wake without ULF_WAKE_ALL picks one thread that is still queued on the address and returns
+ * ENOENT when there is none. The kernel takes a thread off the queue for exactly one reason
+ * (woken, timed out or interrupted by a signal), so a thread that times out or is interrupted
+ * never swallows a wake: it goes to the next sleeper. A thread woken in the wait-any loop of
+ * msync_wait_objs goes straight back to taking the object; if it fails, someone else took it.
+ * The threads that can be woken and not take the object are the wait-all ones, which wait
+ * for each object in turn and take them all later: they hand the wake on (pass_wakes below)
+ * before they sleep again or leave. Waiters with an alert object or several objects wait
+ * through the wineserver's list, which signal_waiters still wakes completely, as before.
+ *
+ * SQUARK_MSYNC_WAKE_ALL=1 wakes every single-object waiter again. */
+#define WAKE_ALL_WAITERS (~0u)
+
+static int msync_wake_all(void)
+{
+    static int cached = -1;
+
+    if (cached == -1)
+    {
+        const char *env = getenv( "SQUARK_MSYNC_WAKE_ALL" );
+        cached = env && atoi( env );
+    }
+    return cached;
+}
+
+/* wake one thread sleeping on the object itself; 0 if none was */
+static inline int wake_one( void *shm )
+{
+    return !__ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_NO_ERRNO, shm, 0 );
+}
+
+static inline void signal_waiters( void *shm, unsigned int shm_idx, unsigned int wake_count )
 {
     __thread static mach_msg_header_t send_header;
     struct event *event_obj = (struct event *)shm;
 
-    __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, shm, 0 );
+    /* One wake call costs the releasing thread the same whether it wakes one thread or all of them,
+     * and n calls cost it n times as much: a ReleaseSemaphore(7) that woke 7 one by one took 3.7 µs
+     * against 0.7 µs (MSFS 2024's main thread releases ~145 times a frame). So only a release of
+     * one wakes one; more than that wakes all, as before. */
+    if (wake_count != 1 || msync_wake_all())
+        __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, shm, 0 );
+    else
+        wake_one( shm );
 
     if (!__atomic_load_n( &event_obj->multiple_waiters, __ATOMIC_SEQ_CST ))
         return;
@@ -669,6 +715,46 @@ static inline void signal_all( void *shm, unsigned int shm_idx )
                MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
 }
 
+static inline void signal_all( void *shm, unsigned int shm_idx )
+{
+    signal_waiters( shm, shm_idx, WAKE_ALL_WAITERS );
+}
+
+/* whether a thread that took a single wake for the object could leave it to another one */
+static inline int obj_available( void *shm )
+{
+    switch (((struct event *)shm)->msync_type)
+    {
+    case MSYNC_SEMAPHORE:
+        return __atomic_load_n( &((struct semaphore *)shm)->count, __ATOMIC_SEQ_CST ) > 0;
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_AUTO_SERVER:
+        return __atomic_load_n( &((struct event *)shm)->signaled, __ATOMIC_SEQ_CST ) != 0;
+    case MSYNC_MUTEX:
+    {
+        int tid = __atomic_load_n( &((struct mutex *)shm)->tid, __ATOMIC_SEQ_CST );
+        return !tid || tid == ~0;
+    }
+    default:
+        return 0;  /* manual-reset events wake every waiter */
+    }
+}
+
+/* A wait-all thread that was woken on the objects in *woken (one bit each) and is about to
+ * sleep again or leave without taking them: wake the next sleeper of those still free, so
+ * that a wake meant for a thread that takes the object doesn't end with this one. */
+static inline void pass_wakes( void **objs_shm, ULONGLONG *woken )
+{
+    ULONGLONG mask = *woken;
+    int i;
+
+    *woken = 0;
+    if (msync_wake_all()) return;
+    for (i = 0; mask; i++, mask >>= 1)
+        if ((mask & 1) && obj_available( objs_shm[i] ))
+            wake_one( objs_shm[i] );
+}
+
