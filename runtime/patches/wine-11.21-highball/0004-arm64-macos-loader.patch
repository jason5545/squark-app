
diff --git a/configure.ac b/configure.ac
index cbb97ae..72050c0 100644
--- a/configure.ac
+++ b/configure.ac
@@ -998,6 +998,13 @@ case $host_os in
             WINELOADER_LDFLAGS="$WINELOADER_LDFLAGS -Wl,-no_pie,-image_base,0x200000000,-no_huge,-no_fixup_chains,-segalign,0x1000,-segaddr,WINE_RESERVE,0x1000"],
            [wine_use_preloader=yes])
         ;;
+      aarch64)
+        dnl PAGEZERO is at least 4GB on ARM64 macOS. -x86_64_layout_emulation (Xcode 26.4)
+        dnl lets the loader map over it, so it covers the low area Wine needs (see
+        dnl loader/main.c). The image base is the one Highball's signed loader uses. Building
+        dnl the loader for macOS 11 keeps the kernel from clearing x18, the TEB pointer.
+        wine_use_preloader=no
+        WINELOADER_LDFLAGS="-Wl,-platform_version,macos,11.0,11.0,-pagezero_size,0x170000000,-image_base,0x170000000,-x86_64_layout_emulation,-sectcreate,__TEXT,__info_plist,loader/wine_info.plist" ;;
       *)    wine_use_preloader=no ;;
     esac
 
diff --git a/loader/main.c b/loader/main.c
index 71ba308..8893da3 100644
--- a/loader/main.c
+++ b/loader/main.c
@@ -153,6 +153,12 @@ static void *try_dlopen( const char *argv0 )
 
     if ((p = remove_tail( dir, "/loader" )))
         path = build_path( p, "dlls/ntdll/ntdll.so" );
+#if defined(__APPLE__) && defined(__aarch64__)
+    /* A loader that has to carry an entitlement is the main executable of a Wine.app
+     * in the unix dir, beside ntdll.so. */
+    else if ((p = remove_tail( dir, "/Wine.app/Contents/MacOS" )))
+        path = build_path( p, "ntdll.so" );
+#endif
     else
         path = build_path( dir, "ntdll.so" );
 
