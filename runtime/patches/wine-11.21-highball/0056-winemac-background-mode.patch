             [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
 
-            if (activateIfTransformed)
+            if (activateIfTransformed && !macdrv_background_mode())
                 [self tryToActivateIgnoringOtherApps:YES];
 
             if (!enable_app_nap)
@@ -815,6 +839,9 @@ - (BOOL) setMode:(CGDisplayModeRef)mode forDisplay:(CGDirectDisplayID)displayID
