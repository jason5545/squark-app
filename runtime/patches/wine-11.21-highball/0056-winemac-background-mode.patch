diff --git a/dlls/winemac.drv/ime.c b/dlls/winemac.drv/ime.c
index e22f434..d40248e 100644
--- a/dlls/winemac.drv/ime.c
+++ b/dlls/winemac.drv/ime.c
@@ -45,6 +45,11 @@ UINT macdrv_ImeToAsciiEx( UINT vkey, UINT vsc, const BYTE *state, void *update )
 
     if (!state) return STATUS_SUCCESS;
 
+    /* Background mode: the program is never the active app, so a macOS input method the user
+       has selected takes the key and never gives anything back. Go without it, like Windows
+       with no IME: the key arrives as a plain WM_KEYDOWN. */
+    if (macdrv_background_mode()) return STATUS_NOT_IMPLEMENTED;
+
     /* Only key down events should be sent to the Cocoa input context. We do not
      * handle key ups, and instead let those go through as a normal WM_KEYUP.
      */
