+// squark: the dispatcher's compile call. A unit compiled or reinstated by CompileBlock was checked against the guest's
+// bytes under CodeInvalidationMutex. A write fault that invalidates it right after (another thread storing data beside
+// it on the page) takes that lock only once this compile is done, and the store lands after the invalidation, so
+// running the unit this once is the same as having fetched it before the store, as FEX did before the stale exits. The
+// dispatcher enters it past its stale-exit slot: through the slot, the thread kept finding it turned into a branch by
+// then and translated the unit again, about a hundred times per call (smcretire's data-writing thread, 1.0 s -> 89 s).
+uintptr_t ContextImpl::CompileBlockEnter(FEXCore::Core::CpuStateFrame* Frame, uint64_t GuestRIP, uint64_t MaxInst) {
+  auto& Fresh = Frame->Thread->CPUBackend->SquarkFreshEntry;
+  Fresh = 0;
+  const uintptr_t HostCode = CompileBlock(Frame, GuestRIP, MaxInst);
+  const bool PastSlot = HostCode && HostCode == Fresh;
+  Fresh = 0;
+  return PastSlot ? HostCode + 4 : HostCode;
+}
