+#include <atomic>
 #include <cstdlib>
 
 #include "Interface/Context/Context.h"
 #include "Interface/Core/LookupCache.h"
 
 namespace FEXCore {
+void SetStaleEntry(uint64_t HostCode, uint64_t StaleExit, bool Stale) {
+  constexpr uint32_t Nop = 0xD503201FU;
+  const int64_t Words = (static_cast<int64_t>(StaleExit) - static_cast<int64_t>(HostCode)) / 4;
+  if (Words <= 0 || Words >= (1 << 25)) {
+    return;
+  }
+  const uint32_t Branch = 0x14000000U | static_cast<uint32_t>(Words);
+  auto Inst = std::atomic_ref<uint32_t>(*reinterpret_cast<uint32_t*>(HostCode));
+  const uint32_t From = Stale ? Nop : Branch;
+  if (Inst.load(std::memory_order_relaxed) != From) {
+    return;
+  }
+  FEXCore::Context::HbJitWrite(true);
+  Inst.store(Stale ? Branch : Nop, std::memory_order_relaxed);
+  FEXCore::Context::HbJitWrite(false);
+  // One instruction: clean and invalidate its cache line directly. __builtin___clear_cache is FlushInstructionCache on
+  // Windows targets, a system call per entry (twice as slow on code another thread keeps writing next to).
+  asm volatile("dc cvau, %0\n\tdsb ish\n\tic ivau, %0\n\tdsb ish\n\tisb" : : "r"(HostCode) : "memory");
+}
