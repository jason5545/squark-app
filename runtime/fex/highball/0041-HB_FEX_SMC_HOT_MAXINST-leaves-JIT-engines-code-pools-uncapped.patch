+// squark: JIT engines' code pools, for FEXCore::Context::SqJitPoolFn. A pool is a private executable reservation of at
+// least 256 MB: JavaScriptCore reserves one of 1 GB (Microsoft Flight Simulator's Coherent GT, Bun), while a copy
+// protection's or a hook's code sits in images or small allocations. A pool is listed the first time a hot unit starts
+// in it and dropped when the reservation is released. Readers take no lock; JitPoolMutex orders the writers (taken
+// while compiling, so never ThreadCreationMutex there). SQUARK_FEX_HOT_JITPOOLS=1 caps units in pools again.
+struct JitPoolRange {
+  std::atomic<uint64_t> Start;
+  std::atomic<uint64_t> End;
+};
+JitPoolRange JitPools[64];
+std::atomic<uint32_t> JitPoolCount;
+std::mutex JitPoolMutex;
+constexpr uint64_t JitPoolMinSize = 256ULL << 20;
+
+bool IsJitPoolCode(uint64_t RIP) {
+  const uint32_t Count = JitPoolCount.load(std::memory_order_acquire);
+  for (uint32_t i = 0; i < Count; i++) {
+    const uint64_t Start = JitPools[i].Start.load(std::memory_order_acquire);
+    if (RIP >= Start && RIP < JitPools[i].End.load(std::memory_order_acquire)) {
+      return true;
+    }
+  }
+
+  MEMORY_BASIC_INFORMATION Info;
+  if (NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(RIP), MemoryBasicInformation, &Info, sizeof(Info), nullptr) ||
+      Info.Type != MEM_PRIVATE || Info.State != MEM_COMMIT) {
+    return false;
+  }
+  // The reservation's extent: its regions, committed or not, up to the first of another allocation
+  const auto Base = reinterpret_cast<uint64_t>(Info.AllocationBase);
+  uint64_t End = Base;
+  for (uint32_t i = 0; i < 65536; i++) {
+    if (NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(End), MemoryBasicInformation, &Info, sizeof(Info), nullptr) ||
+        Info.State == MEM_FREE || reinterpret_cast<uint64_t>(Info.AllocationBase) != Base) {
+      break;
+    }
+    End = reinterpret_cast<uint64_t>(Info.BaseAddress) + Info.RegionSize;
+  }
+  if (End - Base < JitPoolMinSize || RIP >= End) {
+    return false;
+  }
+
+  std::scoped_lock Lock(JitPoolMutex);
+  const uint32_t Index = JitPoolCount.load(std::memory_order_relaxed);
+  for (uint32_t i = 0; i < Index; i++) {
+    if (JitPools[i].Start.load(std::memory_order_relaxed) == Base) {
+      return true;
+    }
+  }
+  if (Index == std::size(JitPools)) {
+    return true;
+  }
+  JitPools[Index].End.store(End, std::memory_order_relaxed);
+  JitPools[Index].Start.store(Base, std::memory_order_relaxed);
+  JitPoolCount.store(Index + 1, std::memory_order_release);
+  LogMan::Msg::IFmt("FEX: JIT pool {:x}-{:x}", Base, End);
+  return true;
+}
+
+void RemoveJitPools(uint64_t Address, uint64_t Size) {
+  std::scoped_lock Lock(JitPoolMutex);
+  const uint32_t Count = JitPoolCount.load(std::memory_order_relaxed);
+  for (uint32_t i = 0; i < Count; i++) {
+    const uint64_t Start = JitPools[i].Start.load(std::memory_order_relaxed);
+    if (Start && Start - Address < Size) {
+      JitPools[i].Start.store(0, std::memory_order_release);
+      JitPools[i].End.store(0, std::memory_order_release);
+    }
+  }
+}
+
+void InitJitPools() {
+  const char* Setting = std::getenv("SQUARK_FEX_HOT_JITPOOLS");
+  if (!Setting || strcmp(Setting, "1")) {
+    FEXCore::Context::SqJitPoolFn = IsJitPoolCode;
+  }
+}
