+// squark: Size bytes for a unit's stale exits in the current code buffer, outside any unit. Each thread takes an area
+// from the buffer's allocator and fills it unit by unit; a new buffer (the thread moved to another generation, or
+// this call filled the current one) or a full area starts the next. The areas are not registered as blocks: a host PC
+// there is in the code buffer but in no block, and nothing in an exit can fault.
+uint8_t* Arm64JITCore::ClaimStaleExitSpace(size_t Size) {
+  constexpr size_t AreaSize = 64 * 1024;
+  Size = FEXCore::AlignUp(Size, 16);
+  if (StaleExitBuffer.lock() != CurrentCodeBuffer || static_cast<size_t>(StaleExitEnd - StaleExitCursor) < Size) {
+    const size_t Area = std::max(Size, AreaSize);
+    const auto Allocated = AllocateCodeBufferInSharedCache(Area);
+    StaleExitBuffer = CurrentCodeBuffer;
+    StaleExitCursor = Allocated.BufferAllocationOffset;
+    StaleExitEnd = StaleExitCursor + Area;
+  }
+  const auto Result = StaleExitCursor;
+  StaleExitCursor += Size;
+  return Result;
 }
 
+// squark: data to instruction cache coherency for exits just written, in place of a second ClearICache per unit
+// (__builtin___clear_cache is FlushInstructionCache on Windows targets: a system call, as in SetStaleEntry). The
+// stride is the smallest cache line the architecture allows, so no line is skipped whatever the core's size is.
+static void SyncStaleExits(const uint8_t* Begin, size_t Size) {
+  constexpr uintptr_t Stride = 16;
+  const auto Start = reinterpret_cast<uintptr_t>(Begin) & ~(Stride - 1);
+  const auto End = reinterpret_cast<uintptr_t>(Begin) + Size;
+  for (auto Line = Start; Line < End; Line += Stride) {
+    asm volatile("dc cvau, %0" : : "r"(Line) : "memory");
+  }
+  asm volatile("dsb ish" : : : "memory");
+  for (auto Line = Start; Line < End; Line += Stride) {
+    asm volatile("ic ivau, %0" : : "r"(Line) : "memory");
+  }
+  asm volatile("dsb ish\n\tisb" : : : "memory");
+}
