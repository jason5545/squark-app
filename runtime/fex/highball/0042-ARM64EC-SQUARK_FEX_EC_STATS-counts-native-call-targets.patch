ARM64EC: SQUARK_FEX_EC_STATS counts which native functions x64 code calls

Every call from x64 code to native ARM64EC code (an export of an ARM64X or builtin DLL, a COM method of
vkd3d-proton, a return into native code) leaves the JIT through ExitFunctionEC, which writes FPCR to drop the
JIT's bits and writes it again when the call returns. SQUARK_FEX_EC_STATS=<Windows path> points each thread's
ExitFunctionEC at ExitFunctionECStats, which stores the target and the thread id in a ring of 1M entries before
exiting as usual. A worker thread tallies the ring every 100 ms (it samples when more exits than the ring holds
happened in between) and rewrites the file every 5 s: the exits counted, the image of each target (allocation base
and mapped file) and the 400 most frequent {thread, target} pairs. For measuring only; off without the variable.

Microsoft Flight Simulator 2024, A380X at RCTP 05R, 66 s in the cockpit (squark records 25.77): about 9.1 million
exits a second over the process; the main thread mostly RtlEnterCriticalSection/RtlLeaveCriticalSection, SRW locks,
_isnan and libm, Coherent GT's thread FlsGetValue and GetCurrentThreadId, the 17 job workers vkd3d-proton's
CopyDescriptorsSimple, CreateConstantBufferView and SetGraphicsRootDescriptorTable.

diff --git a/Source/Windows/ARM64EC/Module.S b/Source/Windows/ARM64EC/Module.S
index b9d521d..0d02211 100644
--- a/Source/Windows/ARM64EC/Module.S
+++ b/Source/Windows/ARM64EC/Module.S
@@ -114,6 +114,24 @@ ret_sp_misaligned:
   ldr lr, [lr, #:lo12:X64ReturnInstr]
   br x17
 
+  // SQUARK_FEX_EC_STATS (squark 0042): ThreadInit points Pointers.ExitFunctionEC here instead. Records the target
+  // (x9) and the thread (TEB ClientId.UniqueThread) in ECStatsRing, then exits as usual. x16 and x17 are free here, as
+  // ExitFunctionEC overwrites both first; ldadd, and and add leave NZCV alone.
+.arch_extension lse
+.global ExitFunctionECStats
+ExitFunctionECStats:
+  adrp x17, ECStatsIndex
+  add x17, x17, #:lo12:ECStatsIndex
+  mov x16, #1
+  ldadd x16, x16, [x17]
+  and x16, x16, #0xfffff // ECStats::RingEntries - 1
+  adrp x17, ECStatsRing
+  ldr x17, [x17, #:lo12:ECStatsRing]
+  add x17, x17, x16, lsl #4
+  ldr x16, [x18, #0x48] // TEB->ClientId.UniqueThread
+  stp x9, x16, [x17]
+  b ExitFunctionEC
+
 .global ExitFunctionSuspendPoint
 ExitFunctionSuspendPoint:
   brk #0xCAFE
