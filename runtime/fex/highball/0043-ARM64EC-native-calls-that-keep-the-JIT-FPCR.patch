+namespace FPCRNeutral {
+// squark 0043: which native functions x64 code may call without FPCR leaving the JIT's mode. Two sources:
+// - 0036: memcpy, memmove and memset of Wine's builtin ucrtbase, msvcrt and ntdll (AddCRTTargets);
+// - FPCRNeutralTable.inc, generated when the runtime is built by squark-app's runtime/fex/fpcrscan.py from that
+//   build's Wine DLLs: every function from which nothing reachable is affected by AH, NEP or the trap enables (no
+//   floating-point data processing, no FPCR write, no unknown indirect call); an image is used only when its name,
+//   TimeDateStamp and .text size are the ones scanned. Calls into Wine's syscall and unix call dispatchers, its debug
+//   output and its ARM64EC syscall wrappers are allowed because Wine patch 0070 drops the JIT's bits there, and calls
+//   into FEX's own exports because they do too (FPCRFence below). SQUARK_FEX_FPCR_TABLE=0 leaves the table out.
+// Inserted under ThreadCreationMutex (image map), read without a lock by ExitFunctionEC.
+constexpr uint64_t Slots = std::size(FPCRNeutralHash);
+static_assert(Slots == (1 << 15), "Module.S masks with 0x7fff");
+uint64_t Used;
+
+uint64_t Hash(uint64_t Target) {
+  return ((Target ^ (Target >> 15)) >> 2) & (Slots - 1);
+}
+
+bool Insert(uint64_t Target) {
+  for (uint64_t i = Hash(Target);; i = (i + 1) & (Slots - 1)) {
+    const uint64_t Value = FPCRNeutralHash[i];
+    if (Value == Target) {
+      return false;
+    }
+    if (Value <= 1) {
+      if (Value == 0) {
+        if (Used >= Slots * 3 / 4) {
+          return false; // keep empty slots so that every probe ends
+        }
+        Used++;
+      }
+      __atomic_store_n(&FPCRNeutralHash[i], Target, __ATOMIC_RELEASE);
+      return true;
+    }
+  }
+}
+
+struct Image {
+  const char* Name;
+  uint32_t TimeDateStamp;
+  uint32_t TextSize; // VirtualSize of .text: strip keeps it, unlike SizeOfImage
+  size_t Count;
+  const uint32_t* RVAs;
+};
+using FPCRNeutralImage = Image;
+#if __has_include("FPCRNeutralTable.inc")
+#include "FPCRNeutralTable.inc"
+#else
+static const FPCRNeutralImage FPCRNeutralImages[] = {{"", 0, 0, 0, nullptr}};
+#endif
+
+bool TableEnabled() {
+  static const bool Enabled = [] {
+    const char* Setting = std::getenv("SQUARK_FEX_FPCR_TABLE");
+    return !Setting || strcmp(Setting, "0");
+  }();
+  return Enabled;
+}
+
+bool NameIs(std::string_view ModuleName, std::string_view Name) {
+  return ModuleName.size() == Name.size() &&
+         std::equal(Name.begin(), Name.end(), ModuleName.begin(), [](char a, char b) { return a == std::tolower(b); });
+}
+
+void AddTableTargets(std::string_view ModuleName, uint64_t Address) {
+  if (!TableEnabled()) {
+    return;
+  }
+  const auto* Nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(Address + reinterpret_cast<const IMAGE_DOS_HEADER*>(Address)->e_lfanew);
+  for (const auto& Entry : FPCRNeutralImages) {
+    if (!Entry.Count || !NameIs(ModuleName, Entry.Name)) {
+      continue;
+    }
+    uint32_t TextSize = 0;
+    const auto* Section = IMAGE_FIRST_SECTION(Nt);
+    for (unsigned i = 0; i < Nt->FileHeader.NumberOfSections; i++) {
+      if (!memcmp(Section[i].Name, ".text\0\0", 8)) {
+        TextSize = Section[i].Misc.VirtualSize;
+      }
+    }
+    if (Nt->FileHeader.TimeDateStamp != Entry.TimeDateStamp || TextSize != Entry.TextSize) {
+      LogMan::Msg::IFmt("FEX: {} is not the build FPCRNeutralTable was made from, no entries", ModuleName);
+      continue;
+    }
+    size_t Added = 0;
+    for (size_t i = 0; i < Entry.Count; i++) {
+      Added += Insert(Address + Entry.RVAs[i]);
+    }
+    LogMan::Msg::IFmt("FEX: {} {} functions keep the JIT's FPCR ({} slots used)", ModuleName, Added, Used);
+  }
+}
