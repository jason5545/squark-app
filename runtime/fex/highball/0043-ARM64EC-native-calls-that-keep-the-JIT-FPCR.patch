+// squark 0043: FEX's exports that ntdll calls through pointers (pNotifyMemoryAlloc...) can be reached from a native
+// function that runs with the JIT's FPCR. They drop its bits for the rest of the call, like Wine's debug output and
+// syscall wrappers do (Wine patch 0070); the JIT writes them back when the call returns to x64 code.
+static inline void NativeFPCR() {
+  uint64_t Value;
+  __asm__ volatile("mrs %0, fpcr" : "=r"(Value));
+  if (Value & 0x9f06) { // AH, NEP, the trap enables IOE DZE OFE UFE IXE IDE
+    __asm__ volatile("msr fpcr, %0" ::"r"(Value & ~uint64_t {0x9f06}));
+  }
+}
