+// squark 0047: the guest return address of a call whose return block the decoder left to another unit (Decoder::
+// JoinsLiveEntry), or 0. Such a call still pushes a call-ret entry, for a branch to that unit placed after the call:
+// the return is predicted (call-ret stack and the host's return stack) as when the return block was in this unit.
+uint64_t Arm64JITCore::SquarkJoinedReturn(const IR::IROp_ExitFunction* Op) const {
+  uint64_t ReturnRIP = 0;
+  if (Op->Hint != IR::BranchHint::Call || !Op->CallReturnBlock.IsInvalid() || Op->CallReturnAddress.IsInvalid()) {
+    return 0;
+  }
+  if (Op->CallReturnAddress.IsImmediate()) {
+    return 0;
+  }
+  // CALLOp's return address is GetRelocatedPC: an EntrypointOffset
+  const auto Header = IR->GetOp<IR::IROp_Header>(Op->CallReturnAddress);
+  if (Header->Op == IR::IROps::OP_ENTRYPOINTOFFSET) {
+    ReturnRIP = Entry + Header->C<IR::IROp_EntrypointOffset>()->Offset;
+    if (Header->Size == IR::OpSize::i32Bit) {
+      ReturnRIP &= 0xFFFF'FFFFULL;
+    }
+  } else if (!IsInlineConstant(Op->CallReturnAddress, &ReturnRIP) && !IsInlineEntrypointOffset(Op->CallReturnAddress, &ReturnRIP)) {
+    return 0;
+  }
+  return ThreadState->FrontendDecoder->IsJoinedReturn(ReturnRIP) ? ReturnRIP : 0;
 }
 
