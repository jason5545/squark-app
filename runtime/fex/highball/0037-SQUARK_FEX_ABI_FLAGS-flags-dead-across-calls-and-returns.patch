+// SQUARK_FEX_ABI_FLAGS: ';'-separated pieces of module paths (any case) whose code is compiler output that keeps no
+// flag live across a call or a return, such as the DLLs Microsoft Flight Simulator compiles from WebAssembly. Their
+// address ranges, append-only; an unmapped image's range becomes empty. Written under ThreadCreationMutex.
+fextl::vector<fextl::string> ABILocalFlagsModules;
+struct ABILocalFlagsRange {
+  std::atomic<uint64_t> Start;
+  std::atomic<uint64_t> End;
+};
+ABILocalFlagsRange ABILocalFlagsRanges[256];
+std::atomic<uint32_t> ABILocalFlagsRangeCount;
+
+bool IsABILocalFlagsCode(uint64_t RIP) {
+  const uint32_t Count = ABILocalFlagsRangeCount.load(std::memory_order_acquire);
+  for (uint32_t i = 0; i < Count; i++) {
+    const uint64_t Start = ABILocalFlagsRanges[i].Start.load(std::memory_order_acquire);
+    if (RIP >= Start && RIP < ABILocalFlagsRanges[i].End.load(std::memory_order_acquire)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void InitABILocalFlags() {
+  const char* Setting = std::getenv("SQUARK_FEX_ABI_FLAGS");
+  if (!Setting || !*Setting) {
+    return;
+  }
+  std::string_view List {Setting};
+  while (!List.empty()) {
+    const auto End = List.find(';');
+    fextl::string Piece {List.substr(0, End)};
+    for (auto& c : Piece) {
+      c = std::tolower(static_cast<unsigned char>(c));
+    }
+    if (!Piece.empty()) {
+      ABILocalFlagsModules.push_back(std::move(Piece));
+    }
+    List = End == std::string_view::npos ? std::string_view {} : List.substr(End + 1);
+  }
+  if (!ABILocalFlagsModules.empty()) {
+    FEXCore::Context::SqABILocalFlagsFn = IsABILocalFlagsCode;
+  }
+}
+
+void AddABILocalFlagsModule(const fextl::string& ModulePath, uint64_t Address) {
+  if (ABILocalFlagsModules.empty()) {
+    return;
+  }
+  fextl::string Path = ModulePath;
+  for (auto& c : Path) {
+    c = std::tolower(static_cast<unsigned char>(c));
+  }
+  if (std::none_of(ABILocalFlagsModules.begin(), ABILocalFlagsModules.end(),
+                   [&](const fextl::string& Piece) { return Path.find(Piece) != fextl::string::npos; })) {
+    return;
+  }
+  const uint32_t Index = ABILocalFlagsRangeCount.load(std::memory_order_relaxed);
+  if (Index == std::size(ABILocalFlagsRanges)) {
+    LogMan::Msg::EFmt("FEX: no room to list {} for SQUARK_FEX_ABI_FLAGS", ModulePath);
+    return;
+  }
+  const auto* Nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(Address + reinterpret_cast<const IMAGE_DOS_HEADER*>(Address)->e_lfanew);
+  ABILocalFlagsRanges[Index].End.store(Address + Nt->OptionalHeader.SizeOfImage, std::memory_order_relaxed);
+  ABILocalFlagsRanges[Index].Start.store(Address, std::memory_order_relaxed);
+  ABILocalFlagsRangeCount.store(Index + 1, std::memory_order_release);
+  LogMan::Msg::IFmt("FEX: {} at {:x} uses call and return boundaries for flags", ModulePath, Address);
+}
+
+void RemoveABILocalFlagsModule(uint64_t Address, uint64_t Size) {
+  const uint32_t Count = ABILocalFlagsRangeCount.load(std::memory_order_relaxed);
+  for (uint32_t i = 0; i < Count; i++) {
+    const uint64_t Start = ABILocalFlagsRanges[i].Start.load(std::memory_order_relaxed);
+    if (Start && Start - Address < Size) {
+      ABILocalFlagsRanges[i].Start.store(0, std::memory_order_release);
+      ABILocalFlagsRanges[i].End.store(0, std::memory_order_release);
+    }
+  }
+}
+
 void HandleImageMap(uint64_t Address, bool MainImage = false) {
   fextl::string ModulePath = FEX::Windows::GetSectionFilePath(Address);
   fextl::string ModuleName = fextl::string {FEX::Windows::BaseName(ModulePath)};
   InvalidationTracker->HandleImageMap(ModuleName, Address);
   ImageTracker->HandleImageMap(ModulePath, Address, MainImage);
   AddFPCRNeutralTargets(ModuleName, Address);
+  AddABILocalFlagsModule(ModulePath, Address);
 }
 
 void HandleImageUnmap(uint64_t Address, uint64_t Size) {
   RemoveFPCRNeutralTargets(Address, Size);
+  RemoveABILocalFlagsModule(Address, Size);
   ImageTracker->HandleImageUnmap(Address, Size);
 }
