+      // squark: a return whose call-ret stack prediction holds falls through to the ret. The L1 lookup for the other
+      // case used to sit between the compare and the ret, eight instructions every return branched over; it is emitted
+      // after the unit's code (JIT.cpp, PendingReturnLookups), the same instructions in the same order.
+      auto& Lookup = PendingReturnLookups.emplace_back();
+      Lookup.RipReg = RipReg;
+      ldp<ARMEmitter::IndexType::POST>(TMP1, TMP2, REG_CALLRET_SP, CallRetEntrySize);
