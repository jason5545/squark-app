+        ldar(TMP3, TMP3);
+        sub(TMP1, TMP1, TMP3);
+        cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP1, &Lookup.Label);
+      }
+      ret(TMP2);
+      return;
