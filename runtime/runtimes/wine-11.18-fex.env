# Wine 11.18 for Apple Silicon with Highball's arm64 line: Wine's patches-arm64 0018 to 0052
# (patches/wine-11.18-fex) and FEX 2610 with Highball's fex/patches and Darwin unix helper
# (fex/highball), the combination Highball ran Microsoft Flight Simulator 2024 on. GStreamer
# goes in for the videos games play through Media Foundation. Needs macOS 26.5 and a loader
# signed with the cross-architecture entitlement, see the arm64 part of build-wine.sh.
RUNTIME_ID=wine-11.18-fex
RUNTIME_NAME="Wine 11.18 (Apple Silicon, Highball)"
ARCH=arm64
WINE_TAG=wine-11.18
WINE_COMMIT=7b3fff76fa5178f6ce0141b2c776afa2a822f101
FEX_SERIES=highball
GSTREAMER=yes
