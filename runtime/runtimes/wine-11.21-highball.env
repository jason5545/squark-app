# Wine 11.21 for Apple Silicon with Highball's arm64 line moved over from 11.18: Wine's
# patches-arm64 0018 to 0052 and ours (patches/wine-11.21-highball, see its README), FEX 2610
# with Highball's fex/patches and Darwin unix helper (fex/highball), as in wine-11.18-fex.
# GStreamer goes in for the videos games play through Media Foundation, SDL for winebus's
# gamepad layout. Needs macOS 26.5 and a loader signed with the cross-architecture entitlement,
# see the arm64 part of build-wine.sh. wine-11.21-fex is Hadron's own, without Highball's series.
RUNTIME_ID=wine-11.21-highball
RUNTIME_NAME="Wine 11.21 (Apple Silicon, Highball)"
ARCH=arm64
WINE_TAG=wine-11.21
WINE_COMMIT=2528aff26208257fdbf980666a4f0e66d47563ce
FEX_SERIES=highball
GSTREAMER=yes
SDL=yes
